# Copy to /etc/pocketbase/<client>.env — one file per client, e.g.
# /etc/pocketbase/tailor-shop.env — and give each client a unique PORT.

PORT=8091

# Used only by backup-pocketbase.sh. Create this superuser once with:
#   /opt/pocketbase/pocketbase superuser create <email> <password> --dir /srv/clients/<client>/pb_data
BACKUP_PB_SUPERUSER_EMAIL=
BACKUP_PB_SUPERUSER_PASSWORD=

# rclone remote + path this client's backups get pushed to, e.g.
# "b2-backups:tailor-shop-backups" (configure the remote once with
# `rclone config` — Backblaze B2's free tier comfortably covers a
# single shop's nightly SQLite snapshots).
BACKUP_RCLONE_REMOTE=

# How many days of backups to keep, both on the VPS and at the remote.
BACKUP_RETENTION_DAYS=14
