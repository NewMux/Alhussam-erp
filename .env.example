# Supabase Postgres connection string (Project Settings → Database →
# Connection string → URI). Prefer the pooled "Transaction" connection string
# for external hosts like Railway.
DATABASE_URL=

# Email address that is automatically granted the admin role the first time
# it registers/signs in. Set this to the shop owner's email before go-live.
OWNER_EMAIL=

NODE_ENV=development

# Supabase Project Settings → API. Used by the client bundle (Vite inlines
# these at BUILD time — set them before `pnpm build` runs) AND read
# server-side to verify access tokens via supabase.auth.getUser().
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: only needed if the file storage proxy (server/_core/storageProxy.ts) is used.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
