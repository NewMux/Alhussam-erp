# Base URL of this shop's PocketBase instance (e.g. its subdomain on the
# shared VPS: https://tailor.example.com). No trailing slash.
POCKETBASE_URL=

# Superuser credentials the Node server authenticates as to read/write every
# collection. Create this account once with `pocketbase superuser create`
# on the PocketBase instance itself. Never exposed to the browser.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# Email address that is automatically granted the admin role the first time
# it registers/signs in. Set this to the shop owner's email before go-live.
OWNER_EMAIL=

NODE_ENV=development

# Same PocketBase URL as above, but read by the browser bundle (Vite inlines
# this at BUILD time — set it before `pnpm build` runs).
VITE_POCKETBASE_URL=

# Optional: only needed if the file storage proxy (server/_core/storageProxy.ts) is used.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
